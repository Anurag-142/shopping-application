*.tfstate
*.tfstate.*
*.tfstate.backup
tfplan
*.tfplan
*.tfvars
*.tfvars.json
terraform.tfvars
terraform.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl
infra-outputs.json

# Kubernetes — never commit kubeconfig or generated secret manifests
kubeconfig
kubeconfig.yaml
*.kubeconfig
k8s/*-secret-real.yaml
k8s/*-secret-prod.yaml
# VS Code — may contain tokens
.vscode/
